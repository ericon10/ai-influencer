# Character Studio deployment secrets. Copy to .env and fill in.
#
# Provider API keys (Higgsfield, Anthropic, and later others) do NOT go
# here. Enter them in Settings; they are encrypted per account.

# Database. Leave empty to use local PGlite (embedded Postgres, no install).
DATABASE_URL=
PGLITE_DIR=.data/pg

# File storage: "local" (default) or "s3" (Cloudflare R2 or any S3-compatible store).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/blobs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Encryption keys: 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# STUDIO_MASTER_KEYS encrypts provider keys. Comma-separated "version:key"
# pairs; the first is used for new secrets, the rest stay readable for rotation.
# Local development generates throwaway keys in .data/ when these are empty.
STUDIO_MASTER_KEYS=
STUDIO_SESSION_SECRET=

# Owner login (v1 has one account). Required in production; on first boot the
# passphrase is hashed into the database and can then be removed from here.
STUDIO_OWNER_EMAIL=
STUDIO_OWNER_PASSPHRASE=

# Public URL of this deployment, used for provider webhooks.
# Leave empty locally: the job runner falls back to polling.
STUDIO_PUBLIC_URL=

# API server port for local development (Vite proxies /api/v1 to it).
STUDIO_API_PORT=8787

LOG_LEVEL=info
