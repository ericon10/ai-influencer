// Copies the editor's preset library (the OpenReel fork's
// packages/core/src/studio/presets.ts) into config/presets.yaml, so the
// worker renders a preset with the same keys the editor places. Run it
// after changing presets in the fork (npm run presets:sync); the check in
// server/config/presets.test.ts fails while the two differ.
//   OPENREEL_DIR=/path/to/openreel-video npm run presets:sync
import { existsSync, readFileSync, writeFileSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { stringify } from 'yaml'

const pin = JSON.parse(readFileSync(resolve('editor/openreel.json'), 'utf8')) as { repo: string; commit: string }
const dir = process.env.OPENREEL_DIR || resolve('.data/openreel')
const file = join(dir, 'packages/core/src/studio/presets.ts')
if (!existsSync(file)) throw new Error(`No editor checkout at ${dir} (set OPENREEL_DIR).`)
const { PRESETS } = (await import(file)) as { PRESETS: Array<Record<string, unknown>> }
const presets = PRESETS.map(p => ({
  id: p.id, label: p.label, kind: p.kind, category: p.category, anchor: p.anchor, duration: p.duration,
  ...(p.keys ? { keys: p.keys } : {}),
}))
const header = '# Generated by `npm run presets:sync` from the editor fork (do not edit by hand).\n# The worker renders camera presets with these keys (editor phase D, G32).\n'
writeFileSync(resolve('config/presets.yaml'), header + stringify({ source: { repo: pin.repo, commit: pin.commit }, presets }, { lineWidth: 0, flowLevel: 3 }))
console.log(`config/presets.yaml: ${presets.length} presets from ${pin.commit.slice(0, 7)}`)
