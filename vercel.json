{
  "regions": ["iad1"],
  "functions": {
    "api/studio.ts": {
      "includeFiles": "{config/**,server/db/migrations/**}",
      "excludeFiles": "{.data/**,.vercel/**,dist/**,dist-worker/**,fixtures/**,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/studio?__path=$1"
    },
    {
      "source": "/api/hf/(.*)",
      "destination": "/api/hfproxy?__hfpath=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
