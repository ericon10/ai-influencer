{
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/studio.ts": {
      "includeFiles": "{config/**,server/**,package.json,package-lock.json}",
      "excludeFiles": "{.data/**,.vercel/**,dist/**,dist-worker/**,fixtures/**,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/studio?__path=$1"
    },
    {
      "source": "/api/hf/(.*)",
      "destination": "/api/hfproxy?__hfpath=$1"
    },
    {
      "source": "/editor",
      "destination": "/editor/index.html"
    },
    {
      "source": "/editor/",
      "destination": "/editor/index.html"
    },
    {
      "source": "/((?!api/|editor/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/editor",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/editor/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/editor/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
