{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["server/**", "config/**", "comfy/workflows/**", "comfy/env/environment.lock.json", "scripts/fetch-models.mjs", "package.json", "package-lock.json", "Dockerfile", "railway.json"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "sleepApplication": true,
    "numReplicas": 1
  }
}
