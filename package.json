{
  "name": "ai-influencer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "tsx watch --clear-screen=false server/dev.ts",
    "studio": "node scripts/studio.mjs",
    "worker": "tsx server/worker.ts",
    "build:worker": "esbuild server/worker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist-worker/worker.mjs",
    "start:worker": "node --enable-source-maps --max-old-space-size=384 dist-worker/worker.mjs",
    "models": "node scripts/fetch-models.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:text": "tsx scripts/check-no-emdash.ts",
    "check": "npm run typecheck && npm run lint:text && npm run test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@electric-sql/pglite": "^0.5.9",
    "@higgsfield/client": "0.2.6",
    "@hono/node-server": "^2.1.4",
    "@tanstack/react-query": "^5.104.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "2.2.5",
    "axios": "1.20.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^0.460.0",
    "onnxruntime-web": "^1.30.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.21.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.1",
    "vitest": "^3.2.7"
  }
}
